- name: Setup Web Servers
  hosts: web
  become: yes

  tasks:
    - name: Install nginx
      apt:
        name: nginx
        state: present
        update_cache: yes

    - name: Ensure nginx is running
      service:
        name: nginx
        state: started
        enabled: yes

    - name: Deploy test HTML
      template:
        src: templates/index.html.j2
        dest: /var/www/html/index.html
